# MyStock Backend - Environment Configuration Example
# Copy this file to .env and update with your actual values

# Application
APP_NAME=MyStock
APP_ENV=development
LOG_LEVEL=INFO

# API Configuration
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Security
SECRET_KEY=your-secret-key-change-this-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# Database - Azure Cosmos DB
COSMOS_ENDPOINT=https://localhost:8081
COSMOS_KEY=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==
COSMOS_DATABASE_NAME=mystockdb

# External API - Alpha Vantage
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key-get-free-at-alphavantage.co
STOCK_CACHE_TTL_SECONDS=60

# Azure (for cloud deployment)
AZURE_TENANT_ID=your-tenant-id
AZURE_SUBSCRIPTION_ID=your-subscription-id
